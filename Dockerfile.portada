# Servicio HTTP de portadas para n8n.  docker build -f Dockerfile.portada -t criptonautas-portada .
# Requiere haber corrido `make` antes (usa el logo horizontal de dist/).
FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends libcairo2 fontconfig \
 && rm -rf /var/lib/apt/lists/* \
 && pip install --no-cache-dir cairosvg pillow
WORKDIR /app
COPY fonts-src/*.ttf /usr/share/fonts/truetype/criptonautas/
COPY fonts-src/InterTight.ttf /app/fonts-src/
COPY dist/logo/horizontal/criptonautas-horizontal-color.svg /app/dist/logo/horizontal/
COPY src/portada.py /app/src/
RUN fc-cache -f && python src/portada.py --probar
USER nobody
EXPOSE 8787
CMD ["python", "src/portada.py", "--servir", "--host", "0.0.0.0", "--puerto", "8787"]
